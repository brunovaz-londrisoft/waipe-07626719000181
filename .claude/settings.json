{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/waipe/waipe.py:*)",
      "Bash(python3 .claude/waipe/plugins.py:*)",
      "Bash(node .claude/waipe/plugin/validar.mjs:*)",
      "Bash(node .claude/waipe/plugin/previa.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git tag -d:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/waipe/waipe.py\" hook"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/waipe/plugins.py\" hook"
          }
        ]
      }
    ]
  }
}
