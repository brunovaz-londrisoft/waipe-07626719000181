{
  "formato": "waipe-paginas/1",
  "slug": "giro",
  "nome": "Giro de Estoque",
  "rotulo": "Giro",
  "descricao": "Giro, cobertura, curva ABC e sugestão de compra de cada produto, com o que mudou a cada dia.",
  "icone": "grafico",
  "categoria": { "nome": "Produtos", "icone": "caixa" },
  "ordem": 30,
  "versao": "2.1.0",
  "itens": "produtos",
  "abas": { "relatorio": "Relatório de giro", "consolidado": "Fabricantes" },
  "dataLab": {
    "relatorio": "Giro de Estoque",
    "texto": "liste todos os Produtos Ativos:\nCódigo do Produto,\nNome do Produto,\nFabricante do Produto,\nQuantidade vendidos nos {ultimos_90_dias},\nQuantidade de Estoque Atual.",
    "colunas": "código, nome, fabricante, quantidade vendida e estoque atual. O {ultimos_90_dias} define o período das vendas: se trocar, ajuste o \"Período analisado\" na regra do giro."
  },
  "integracao": {
    "agendamento": {
      "hora": 7,
      "minuto": 0
    },
    "passos": [
      {
        "titulo": "Crie o relatório no Data Lab",
        "blocos": [
          {
            "texto": "No Waipe, abra o **Data Lab**, crie um relatório chamado **{{relatorio}}** com o texto abaixo e salve."
          },
          {
            "ferramenta": "datalab"
          },
          {
            "texto": "Depois de salvar, copie o **ID do relatório** (aparece no Data Lab, na URL ou nos detalhes do relatório) e cole aqui:"
          },
          {
            "ferramenta": "id_relatorio"
          }
        ]
      },
      {
        "titulo": "Baixe os dois flows (já configurados para esta empresa)",
        "blocos": [
          {
            "ferramenta": "baixar_flows"
          }
        ]
      },
      {
        "titulo": "Importe no Waipe Flow e ative",
        "blocos": [
          {
            "texto": "No Waipe Flow, importe os dois arquivos (o node **Waipe Data** já vem com o relatório **{{relatorio}}**), salve e **ative** os dois flows."
          }
        ]
      },
      {
        "titulo": "Cole aqui a URL do webhook",
        "blocos": [
          {
            "texto": "Abra o flow **Atualizar pelo Painel**, clique no gatilho **Atualizar pelo Painel** e copie a URL do webhook."
          },
          {
            "ferramenta": "webhook"
          }
        ]
      },
      {
        "titulo": "Teste",
        "blocos": [
          {
            "texto": "Clique em testar: o painel chama o flow, que busca o Data Lab e envia os dados (leva alguns segundos). Depois disso o flow agendado atualiza sozinho todo dia às {{horario}}."
          },
          {
            "ferramenta": "testar"
          }
        ]
      }
    ]
  },
  "parametros": [
    { "chave": "periodoDias", "tipo": "inteiro", "rotulo": "Período das vendas", "padrao": 90, "min": 1, "max": 730, "sufixo": "dias" },
    { "chave": "diasProjecaoCompra", "tipo": "inteiro", "rotulo": "Comprar para", "padrao": 45, "min": 1, "max": 365, "sufixo": "dias",
      "ajuda": "A sugestão é o que falta para o estoque cobrir esses dias no ritmo atual de venda. **Mais dias** = pedidos maiores e menos frequentes (mais capital em estoque); **menos dias** = pedidos menores e mais frequentes. Muda só a coluna \"Sugestão compra\" e o total de unidades a comprar; não muda o status." },
    { "chave": "abcCorteA", "tipo": "percentual", "rotulo": "Curva A até", "padrao": 0.8, "min": 0.01, "max": 0.99, "sufixo": "% da saída" },
    { "chave": "abcCorteB", "tipo": "percentual", "rotulo": "Curva B até", "padrao": 0.95, "min": 0.02, "max": 0.999, "sufixo": "% da saída" },
    { "chave": "tratarNegativoComoZero", "tipo": "booleano", "rotulo": "Tratar estoque negativo como zero na sugestão", "padrao": false,
      "ajuda": "Estoque negativo costuma ser venda lançada antes da entrada da nota. **Desmarcado** (padrão): a sugestão inclui as unidades que faltam para zerar o negativo. **Marcado**: o negativo é ignorado e a sugestão cobre só a venda futura." },
    { "chave": "coberturaPorCurva", "tipo": "grade", "rotulo": "Curva", "min": 0, "max": 3650, "crescente": true,
      "linhas": ["A", "B", "C"],
      "colunas": [
        { "chave": "critico", "rotulo": "🟠 Comprar urgente até" },
        { "chave": "atencao", "rotulo": "🟡 Comprar até" },
        { "chave": "excesso", "rotulo": "🔵 Excesso a partir de" }
      ],
      "padrao": { "A": { "critico": 10, "atencao": 20, "excesso": 90 }, "B": { "critico": 7, "atencao": 15, "excesso": 150 }, "C": { "critico": 5, "atencao": 10, "excesso": 180 } } },
    { "chave": "fabricanteVazio", "tipo": "texto", "rotulo": "Texto para produto sem fabricante", "padrao": "Sem fabricante", "min": 1,
      "ajuda": "Aparece no lugar do fabricante quando o cadastro do produto não tem um. Ao salvar, os produtos atuais com o texto antigo passam a usar o novo." },
    { "chave": "ignorarNomes", "tipo": "lista", "rotulo": "Produtos ignorados (um por linha)", "padrao": ["CONSUMIDOR FINAL"],
      "ajuda": "Linhas do relatório com exatamente este nome (sem diferenciar maiúsculas) não entram no painel. Vale a partir da próxima atualização." }
  ],
  "validacoes": [
    ["nao (p.abcCorteA > 0 e p.abcCorteA < 1)", "O corte da curva A deve ficar entre 1% e 99%."],
    ["nao (p.abcCorteB > p.abcCorteA e p.abcCorteB < 1)", "O corte da curva B deve ser maior que o da curva A e menor que 100%."]
  ],
  "colunas": {
    "codigo": { "rotulo": "Código do produto", "nomes": ["codigo", "codproduto", "codigodoproduto", "cod"], "obrigatoria": true, "max": 60 },
    "nome": { "rotulo": "Nome do produto", "nomes": ["nome", "nomeproduto", "nomedoproduto", "descricao", "produto"] },
    "fabricante": { "rotulo": "Fabricante", "nomes": ["fabricante", "nomfabricante", "nomefabricante", "fabricantedoproduto", "fabricanteproduto", "nomedofabricante"], "max": 120, "trechos": ["fabric"], "vazioParametro": "fabricanteVazio" },
    "estoque_atual": { "rotulo": "Estoque atual", "nomes": ["estoqueatual", "estoque", "saldo", "saldoestoque", "quantidadeestoque", "quantidadedeestoqueatual"], "obrigatoria": true, "tipo": "numero" },
    "quantidade_vendida": { "rotulo": "Quantidade vendida no período", "nomes": ["quantidadevendida", "qtdvendida", "vendido", "quantidadevendidos", "vendas"], "obrigatoria": true, "tipo": "numero" }
  },
  "entrada": {
    "chave": "codigo",
    "descartar": ["igual(nome, p.ignorarNomes)"]
  },
  "banco": {
    "tabela": "produtos",
    "campos": {
      "codigo": "texto",
      "nome": "texto",
      "fabricante": "texto",
      "estoque_atual": "numero",
      "quantidade_vendida": "numero",
      "saida_por_dia": "numero",
      "cobertura_dias": "inteiro",
      "sugestao_compra": "inteiro",
      "curva_abc": "texto",
      "status": "texto",
      "prioridade": "texto"
    },
    "indices": [["fabricante"], ["status"]],
    "migracoes": []
  },
  "calculo": [
    { "campo": "nome", "formula": "vazio(nome) ? codigo : nome" },
    { "campo": "saida_bruta", "formula": "quantidade_vendida / p.periodoDias" },
    { "campo": "cobertura_dias", "casos": [["estoque_atual <= 0", "0"], ["saida_bruta = 0", "nulo"]], "senao": "arred(estoque_atual / saida_bruta)" },
    { "campo": "sugestao_compra", "formula": "max(0, teto(saida_bruta * p.diasProjecaoCompra - (p.tratarNegativoComoZero e estoque_atual < 0 ? 0 : estoque_atual)))" },
    { "campo": "saida_por_dia", "formula": "arred(saida_bruta, 2)" },
    { "pareto": { "campo": "curva_abc", "valor": "quantidade_vendida", "desempate": "codigo", "cortes": [["p.abcCorteA", "A"], ["p.abcCorteB", "B"]], "resto": "C" } },
    { "campo": "tem_giro", "formula": "saida_por_dia > 0 ou quantidade_vendida > 0" },
    { "campo": "status", "casos": [
        ["estoque_atual <= 0 e tem_giro", "'ruptura'"],
        ["nao tem_giro e estoque_atual > 0", "'parado'"],
        ["nao tem_giro", "'zerado'"],
        ["valor(cobertura_dias, 0) <= p.coberturaPorCurva[curva_abc].critico", "'urgente'"],
        ["valor(cobertura_dias, 0) <= p.coberturaPorCurva[curva_abc].atencao", "'comprar'"],
        ["valor(cobertura_dias, 0) >= p.coberturaPorCurva[curva_abc].excesso", "'excesso'"]
      ], "senao": "'saudavel'" },
    { "campo": "prioridade", "casos": [
        ["status = 'ruptura'", "curva_abc = 'C' ? 'Média' : 'Alta'"],
        ["status = 'urgente'", "curva_abc = 'A' ? 'Alta' : 'Média'"],
        ["status = 'comprar'", "curva_abc = 'A' ? 'Média' : 'Baixa'"],
        ["status = 'excesso'", "curva_abc = 'A' ? 'Baixa' : 'Média'"]
      ], "senao": "'Baixa'" }
  ],
  "dominios": {
    "status": { "estilo": "selo", "valores": {
      "ruptura": { "ordem": 0, "rotulo": "Ruptura, comprar já", "curto": "Ruptura", "icone": "🔴", "cor": "#d03b3b" },
      "urgente": { "ordem": 1, "rotulo": "Comprar urgente", "icone": "🟠", "cor": "#ec835a" },
      "comprar": { "ordem": 2, "rotulo": "Comprar", "icone": "🟡", "cor": "#fab219" },
      "saudavel": { "ordem": 3, "rotulo": "Estoque saudável", "icone": "🟢", "cor": "#0ca30c" },
      "excesso": { "ordem": 4, "rotulo": "Excesso de estoque", "icone": "🔵", "cor": "#2a78d4" },
      "parado": { "ordem": 5, "rotulo": "Estoque parado (sem giro)", "curto": "Estoque parado", "icone": "⚫", "cor": "#55555a" },
      "zerado": { "ordem": 6, "rotulo": "Zerado sem giro", "icone": "⚪", "cor": "#a8a8ad" }
    } },
    "curva_abc": { "estilo": "curva", "valores": { "A": { "ordem": 0 }, "B": { "ordem": 1 }, "C": { "ordem": 2 } } },
    "prioridade": { "valores": { "Alta": { "ordem": 0 }, "Média": { "ordem": 1 }, "Baixa": { "ordem": 2 } } }
  },
  "resumo": {
    "total": "conta()",
    "porStatus": { "contarPor": "status" },
    "porCurva": { "contarPor": "curva_abc" },
    "acaoImediata": "conta(status = 'ruptura' ou status = 'urgente')",
    "aComprar": "conta(status = 'ruptura' ou status = 'urgente' ou status = 'comprar')",
    "sugestaoTotal": "soma(sugestao_compra)",
    "fabricantes": "distintos(fabricante)",
    "estoqueParadoUn": "soma(max(0, estoque_atual), status = 'parado')",
    "estoqueUn": "soma(estoque_atual, estoque_atual > 0)",
    "coberturaMediana": "conta(cobertura_dias <> nulo e estoque_atual > 0) > 0 ? arred(mediana(cobertura_dias, cobertura_dias <> nulo e estoque_atual > 0)) : nulo"
  },
  "grupos": {
    "fabricantes": {
      "campo": "fabricante",
      "por": "fabricante",
      "metricas": {
        "produtos": "conta()",
        "acao_imediata": "conta(status = 'ruptura' ou status = 'urgente')",
        "ruptura": "conta(status = 'ruptura')",
        "urgente": "conta(status = 'urgente')",
        "comprar": "conta(status = 'comprar')",
        "saudavel": "conta(status = 'saudavel')",
        "excesso": "conta(status = 'excesso')",
        "parado": "conta(status = 'parado')",
        "zerado": "conta(status = 'zerado')",
        "curva_a": "conta(curva_abc = 'A')",
        "vendido": "soma(quantidade_vendida)",
        "estoque": "soma(estoque_atual)",
        "sugestao": "soma(sugestao_compra)"
      },
      "ordem": [["acao_imediata", "desc"], ["produtos", "desc"]]
    }
  },
  "historico": {
    "descricao": "nome",
    "campos": [
      { "campo": "fabricante", "titulo": "Fabricante" },
      { "campo": "estoque_atual", "titulo": "Estoque", "numero": true },
      { "campo": "quantidade_vendida", "titulo": "Saída", "numero": true },
      { "campo": "status", "titulo": "Status", "dominio": "status" },
      { "campo": "curva_abc", "titulo": "Curva" }
    ]
  },
  "painel": {
    "titulo": "Indicadores do giro de estoque",
    "texto": "{{atualizacao}}. Vendas dos últimos {{p.periodoDias}} dias, sugestão de compra para {{p.diasProjecaoCompra}} dias. Clique em qualquer número para abrir os produtos.",
    "exportar": { "excel": true, "imprimir": true, "arquivo": "giro", "abaIndicadores": "Indicadores" },
    "kpis": [
      { "chave": "produtos", "rotulo": "Produtos ativos", "valor": "total", "menorMelhor": false, "link": "/giro/relatorio" },
      { "chave": "acao", "rotulo": "Ação imediata", "nota": "ruptura + comprar urgente", "valor": "acaoImediata", "menorMelhor": true, "link": "/giro/relatorio?status=ruptura&status=urgente", "forte": true },
      { "chave": "comprar", "rotulo": "Itens a comprar", "nota": "ruptura + urgente + comprar", "valor": "aComprar", "menorMelhor": true, "link": "/giro/relatorio?status=ruptura&status=urgente&status=comprar" },
      { "chave": "sugestao", "rotulo": "Sugestão de compra", "unidade": "un.", "nota": "para {{p.diasProjecaoCompra}} dias", "valor": "sugestaoTotal", "menorMelhor": true, "link": "/giro/relatorio?sugestao_compra_min=1" },
      { "chave": "parado", "rotulo": "Estoque parado", "unidade": "un.", "nota": "{{br(porStatus.parado)}} itens sem venda em {{p.periodoDias}} dias", "valor": "estoqueParadoUn", "menorMelhor": true, "link": "/giro/relatorio?status=parado" },
      { "chave": "cobertura", "rotulo": "Cobertura mediana", "unidade": "dias", "nota": "dos itens com giro e estoque", "valor": "coberturaMediana", "menorMelhor": false }
    ],
    "blocos": [
      { "tipo": "distribuicao", "largura": 8, "titulo": "Saúde do estoque", "sub": "{{br(total)}} produtos", "excel": "Por status",
        "campo": "status", "dominio": "status", "estilo": "lista", "barra": true, "extra": "soma(max(0, estoque_atual))", "extraTitulo": "Unidades em estoque",
        "detalhe": "{{br(pct, 1)}}% · {{br(extra)}} un.", "link": "/giro/relatorio?status={{valor}}" },
      { "tipo": "ultima" },
      { "tipo": "matriz", "largura": 8, "titulo": "Curva ABC × status", "sub": "clique para ver os produtos", "excel": "Curva x Status",
        "linhas": { "campo": "curva_abc", "dominio": "curva_abc" }, "colunas": { "campo": "status", "dominio": "status" },
        "link": "/giro/relatorio?curva_abc={{linha}}&status={{coluna}}",
        "nota": "Atenção maior para as células do alto à esquerda: produtos A em ruptura ou urgentes são os que mais pesam na venda." },
      { "tipo": "participacao", "largura": 4, "titulo": "Curva ABC", "campo": "curva_abc", "dominio": "curva_abc",
        "soma": "max(0, quantidade_vendida)", "acao": "status = 'ruptura' ou status = 'urgente'", "acaoTitulo": "Ação imediata (ruptura + urgente)",
        "rotulos": ["{{br(pctItens, 1)}}% dos produtos ({{br(qtd)}})", "{{br(pctSoma, 1)}}% da saída"],
        "link": "/giro/relatorio?curva_abc={{valor}}", "nota": "Poucos produtos A fazem a maior parte da saída: são os que não podem faltar." },
      { "tipo": "evolucao", "largura": 12, "titulo": "Evolução diária", "excel": "Evolução",
        "series": [
          { "chave": "acao", "rotulo": "Ação imediata", "cor": "#d03b3b", "valor": "acaoImediata" },
          { "chave": "comprar", "rotulo": "Comprar", "cor": "#c98a00", "valor": "porStatus.comprar" },
          { "chave": "parado", "rotulo": "Estoque parado", "cor": "#55555a", "valor": "porStatus.parado" }
        ] },
      { "tipo": "tabela", "largura": 8, "titulo": "Comprar agora", "sub": "ruptura e urgente, curva A primeiro", "excel": "Comprar agora", "classe": "comprar",
        "filtro": "status = 'ruptura' ou status = 'urgente'", "ordem": [["curva_abc", "asc"], ["saida_por_dia", "desc"]], "limite": 12,
        "colunas": [
          { "titulo": "Produto", "valor": "{{nome}}", "negrito": true, "link": "/giro/item/{{url(codigo)}}", "sub": "{{codigo}} · {{fabricante}}" },
          { "titulo": "Curva", "campo": "curva_abc", "dominio": "curva_abc", "valor": "{{curva_abc}}" },
          { "titulo": "Status", "campo": "status", "dominio": "status", "valor": "{{rotulo('status', status)}}" },
          { "titulo": "Estoque", "valor": "{{br(estoque_atual)}}", "numero": true },
          { "titulo": "Saída/dia", "valor": "{{br(saida_por_dia, 2)}}", "numero": true },
          { "titulo": "Comprar ({{p.diasProjecaoCompra}}d)", "valor": "{{br(sugestao_compra)}}", "numero": true, "negrito": true }
        ],
        "mais": { "link": "/giro/relatorio?status=ruptura&status=urgente", "texto": "Ver todos os {{br(total)}} produtos →" },
        "vazio": "Nada em ruptura ou urgente. 🎉" },
      { "tipo": "faixas", "largura": 4, "titulo": "Cobertura do estoque", "sub": "itens com giro", "excel": "Cobertura",
        "valor": "cobertura_dias", "filtro": "cobertura_dias <> nulo e estoque_atual > 0", "cor": "var(--azul)",
        "faixas": [["Até 7 dias", 0, 7], ["8 a 15", 8, 15], ["16 a 30", 16, 30], ["31 a 60", 31, 60], ["61 a 90", 61, 90], ["91 a 180", 91, 180], ["181 a 365", 181, 365], ["Mais de 1 ano", 366, null]],
        "formato": "{{br(v)}}", "dica": "{{rotulo}}: {{br(v)}} produtos",
        "link": "/giro/relatorio?cobertura_dias_min={{de}}{{ate <> nulo ? '&cobertura_dias_max=' & ate : ''}}",
        "nota": "Quantos dias o estoque dura no ritmo de venda atual. Sem venda no período não entra aqui (é estoque parado)." },
      { "tipo": "ranking", "largura": 6, "titulo": "Fabricantes com mais ação imediata", "excel": "Fabricantes ação",
        "por": "fabricante", "a": "conta(status = 'ruptura')", "b": "conta(status = 'urgente')", "total": "conta(status = 'ruptura' ou status = 'urgente')",
        "manter": "total > 0", "ordem": [["total", "desc"], ["nome", "asc"]], "limite": 10,
        "cores": ["#d03b3b", "#ec835a"], "legendas": ["Ruptura", "Comprar urgente"], "valor": "{{br(total)}}",
        "link": "/giro/relatorio?fabricante={{url(nome)}}&status=ruptura&status=urgente", "vazio": "Nenhum fabricante com ação imediata." },
      { "tipo": "ranking", "largura": 6, "titulo": "Fabricantes com mais estoque parado", "sub": "unidades sem venda em {{p.periodoDias}} dias", "excel": "Fabricantes parado",
        "por": "fabricante", "a": "soma(max(0, estoque_atual), status = 'parado')", "total": "conta(status = 'parado')",
        "manter": "a > 0", "ordem": [["a", "desc"]], "limite": 10,
        "cores": ["#55555a"], "legendas": [], "valor": "{{br(a)}} un. · {{br(total)}} itens",
        "link": "/giro/relatorio?fabricante={{url(nome)}}&status=parado", "vazio": "Nenhum estoque parado." }
    ]
  },
  "relatorio": {
    "titulo": "Relatório de giro de estoque",
    "texto": "{{atualizacao}}. Vendas dos últimos {{p.periodoDias}} dias, sugestão de compra para {{p.diasProjecaoCompra}} dias.",
    "tabela": {
      "titulo": "Relatório de giro de estoque",
      "arquivo": "giro-de-estoque",
      "colunas": [
        { "campo": "codigo", "titulo": "Código", "filtro": "texto", "larguraExcel": 10, "link": "/giro/item/{{url(codigo)}}" },
        { "campo": "nome", "titulo": "Produto", "filtro": "texto", "largura": 260, "larguraExcel": 48 },
        { "campo": "fabricante", "titulo": "Fabricante", "filtro": "multi", "destaque": true, "largura": 150, "larguraExcel": 26 },
        { "campo": "curva_abc", "titulo": "Curva ABC", "dominio": "curva_abc", "filtro": "multi", "destaque": true, "larguraExcel": 10 },
        { "campo": "status", "titulo": "Status", "dominio": "status", "filtro": "multi", "destaque": true, "largura": 190, "larguraExcel": 28 },
        { "campo": "prioridade", "titulo": "Prioridade", "dominio": "prioridade", "filtro": "multi", "destaque": true, "larguraExcel": 11 },
        { "campo": "estoque_atual", "titulo": "Estoque atual", "tipo": "numero", "filtro": "faixa", "casas": 0 },
        { "campo": "cobertura_dias", "titulo": "Cobertura (dias)", "tipo": "numero", "filtro": "faixa", "vazio": "Sem giro" },
        { "campo": "quantidade_vendida", "titulo": "Saída {{p.periodoDias}}d", "tipo": "numero", "filtro": "faixa" },
        { "campo": "saida_por_dia", "titulo": "Saída/dia", "tipo": "numero", "filtro": "faixa", "casas": 2 },
        { "campo": "sugestao_compra", "titulo": "Sugestão compra {{p.diasProjecaoCompra}}d", "tipo": "numero", "filtro": "faixa", "larguraExcel": 16 }
      ],
      "busca": ["codigo", "nome", "fabricante"],
      "ordem": { "campo": "status", "desc": false },
      "cartoes": [
